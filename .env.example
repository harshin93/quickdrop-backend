# App
APP_ENV=local
APP_NAME=QuickDrop

# Auth Service Database
# Local Docker host port: 5433
AUTH_DATABASE_URL=postgresql+psycopg2://quickdrop_auth_user:quickdrop_auth_password@localhost:5433/quickdrop_auth

# Upload Service Database
# Local Docker host port: 5434
UPLOAD_DATABASE_URL=postgresql+psycopg2://quickdrop_upload_user:quickdrop_upload_password@localhost:5434/quickdrop_upload

# JWT
JWT_SECRET_KEY=quickdrop-dev-secret-change-later
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gateway local service URLs
# Docker Compose overrides these internally with:
# AUTH_SERVICE_URL=http://auth_service:8000
# UPLOAD_SERVICE_URL=http://upload_service:8001
AUTH_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_SERVICE_URL=http://127.0.0.1:8001
