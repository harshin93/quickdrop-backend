# QuickDrop local environment example
# Copy this file to .env for local development.
# Never commit your real .env file.

# App
APP_ENV=local
APP_NAME=QuickDrop

# Auth Service Database
# Local Docker host port: 5433
AUTH_DATABASE_URL=postgresql+psycopg2://quickdrop_auth_user:quickdrop_auth_password@localhost:5433/quickdrop_auth

# Upload Service Database
# Local Docker host port: 5434
UPLOAD_DATABASE_URL=postgresql+psycopg2://quickdrop_upload_user:quickdrop_upload_password@localhost:5434/quickdrop_upload

# JWT
# Local development placeholder only. Use a strong random secret outside local development.
JWT_SECRET_KEY=replace-with-a-strong-local-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Upload security
MAX_UPLOAD_SIZE_BYTES=5242880
# For tuple/list values in environment variables, keep JSON-style formatting.
ALLOWED_UPLOAD_CONTENT_TYPES=["text/plain","application/pdf","image/png","image/jpeg"]

# MinIO / S3-compatible object storage
# Local development placeholders only.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=quickdrop_minio_user
S3_SECRET_KEY=quickdrop_minio_password
S3_BUCKET_NAME=quickdrop-uploads
S3_REGION_NAME=us-east-1

# Gateway local service URLs
# Docker Compose overrides these internally with:
# AUTH_SERVICE_URL=http://auth_service:8000
# UPLOAD_SERVICE_URL=http://upload_service:8001
AUTH_SERVICE_URL=http://127.0.0.1:8000
UPLOAD_SERVICE_URL=http://127.0.0.1:8001

# Gateway CORS
# Only known browser frontend origins should be allowed.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
